// Cloudflare Workers settings: serves the app/ folder as static files; worker/index.js answers /api/* only
// (cloud saves and leaderboards, stored in the D1 database DB).
// main deploys the live game (Worker amber-depths, amberdepths.com) with `npx wrangler deploy`.
// staging deploys the test copy (Worker amber-depths-preview, test.amberdepths.com) with
// `npx wrangler deploy --env preview`, with its own empty database so testing never touches real saves.
// Locally: `npx wrangler dev` (a local copy of the database), then http://localhost:8787.
{
  "name": "amber-depths",
  "compatibility_date": "2026-11-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./app",
    "binding": "ASSETS"
  },
  "routes": [{ "pattern": "amberdepths.com", "custom_domain": true }],
  "d1_databases": [
    { "binding": "DB", "database_name": "amber-depths", "database_id": "TODO-create-with-wrangler" }
  ],
  "env": {
    "preview": {
      "routes": [{ "pattern": "test.amberdepths.com", "custom_domain": true }],
      // Bindings aren't inherited by an environment, so the test copy names its own database.
      "d1_databases": [
        { "binding": "DB", "database_name": "amber-depths-preview", "database_id": "TODO-create-with-wrangler" }
      ]
    }
  }
}
