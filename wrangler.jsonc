// Cloudflare Workers settings: serves the app/ folder as static files; worker/index.js answers /api/* only
// (cloud saves and leaderboards, stored in the D1 database DB).
// main deploys the live game (Worker amber-depths, amberdepths.com) with `npx wrangler deploy`.
// staging deploys the test copy (Worker amber-depths-preview, test.amberdepths.com) with
// `npx wrangler deploy --env preview`. The test copy shares the live database, so a sync code works on both sites
// and Sam's save follows him; TEST_COPY makes it ignore scores, so test runs never reach the real leaderboards.
// The server keeps each player's last 10 saves in case a test version damages one.
// Locally: `npx wrangler dev` (a local copy of the database), then http://127.0.0.1:8787.
{
  "name": "amber-depths",
  "compatibility_date": "2026-11-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./app",
    "binding": "ASSETS"
  },
  "routes": [{ "pattern": "amberdepths.com", "custom_domain": true }],
  "d1_databases": [
    { "binding": "DB", "database_name": "amber-depths", "database_id": "f986bdfa-18fd-4d1d-86c0-6acb74e309b7" }
  ],
  "env": {
    "preview": {
      "routes": [{ "pattern": "test.amberdepths.com", "custom_domain": true }],
      // Bindings and vars aren't inherited by an environment, so they're repeated here.
      "d1_databases": [
        { "binding": "DB", "database_name": "amber-depths", "database_id": "f986bdfa-18fd-4d1d-86c0-6acb74e309b7" }
      ],
      "vars": { "TEST_COPY": "1" }
    }
  }
}
